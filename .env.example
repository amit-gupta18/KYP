# Copy this file to backend/.env and fill in the three keys.
# Restart the API after saving.

# OpenAI — chat and embeddings
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# MongoDB — documents, chunks, and question history
MONGODB_URI=
MONGODB_DB=policy_qa

# Pinecone — vector search
PINECONE_API_KEY=
PINECONE_INDEX=policy-qa
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=policies

# Optional
COMPANY_NAME=Policy workspace
MAX_UPLOAD_MB=20
RAG_TOP_K=6
CORS_ORIGINS=*
